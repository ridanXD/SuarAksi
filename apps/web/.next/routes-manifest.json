      "page": "/instance/reports/[id]",
      "regex": "^/instance/reports/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/instance/reports/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
